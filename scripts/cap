#!/usr/bin/env bash
# Run a command inside a rootless, memory-capped cgroup-v2 scope so a runaway
# test dies inside its own cgroup — never the host.
#
#   scripts/cap -- go test -count=1 -p 2 ./pkg/stats/
#   scripts/cap 2G -- go test -count=1 ./services/dns/
#
# MEM defaults to $TAU_CAP_MEM or 3G. A `make` run is a gate, which waits until
# it has the slice to itself (A GATE HAS THE SLICE TO ITSELF, below).
#
# ★★★ THE THING I HAD WRONG FOUR TIMES, taken from warpjs-itr2/scripts/cap after
# the fourth desktop death:
#
# MemoryMax is the HARD ceiling and it WORKS — every kernel OOM since the cap was
# adopted is "Memory cgroup out of memory", contained, host survived.
#
# But a job is free to thrash right up against MemoryMax, and the sustained
# reclaim that causes is SYSTEM-WIDE memory PRESSURE (PSI). systemd-oomd watches
# pressure, not limits, and kills the cgroup under the most pressure — which on a
# desktop is GNOME Shell or a terminal scope, NOT the test. Verified on this box
# 2026-09-04: 11 oomd kills in one boot, victims being vte-spawn scopes and
# gnome-software, with every kernel kill contained and zero global OOMs. The caps
# held and the session died anyway.
#
# MemoryHigh is the missing half: it THROTTLES the cgroup and reclaims inside it
# before the pressure escapes, so the job slows down instead of the desktop
# dying. 90% of MemoryMax.
#
# ★ 90, NOT 75, and the difference is measured rather than tuned. At 75% a job
# whose working set legitimately IS its budget lives permanently in reclaim:
# `go test -c` with an RSS of 3.17G under `cap 4G` was throttled to 3.6% CPU for
# 21 minutes without finishing. MemoryHigh is meant to catch a RUNAWAY before its
# pressure escapes the cgroup, not to strangle a job using what it was given. 90%
# leaves a real throttle band under the hard wall and still fires long before
# MemoryMax. A test with a deadline in it fails under the old value for no reason
# the test could tell you about, which is the worst kind of red.
#
# ★★★ AND AN UNAVAILABLE systemd-run IS NOW A HARD ERROR. The previous version
# fell through to a bare `exec "$@"`, which is a script that reports success
# while capping nothing. "Always safe to invoke" is not the same as "always
# capping", and the difference is only visible after the machine is gone.
#
# TAU_NO_CAP=1 bypasses deliberately (CI with no user systemd session).
#
# ── DO NOT RUN BROAD SWEEPS ON THIS MACHINE ──────────────────────────────
#
# Four host deaths, every one during a `go test ./...` style sweep, none during a
# single-package run. `-p 1` does not make a sweep safe — the third one was
# already -p 1. Tests run PER PACKAGE here, or on the Mac (scripts/mac-test.sh),
# which is where anything heavy belongs.
mem="${TAU_CAP_MEM:-3G}"
case "${1:-}" in
  [0-9]*[GMK]) mem="$1"; shift ;;
esac
[ "${1:-}" = "--" ] && shift

# MemoryHigh = 90% of MemoryMax, in the same unit. 921M per G rather than
# `* 9 / 10` because integer division on a small G value truncates hard: 2G would
# become 1G, which is 50% and not 90%.
high="$mem"
case "$mem" in
  *G) high="$(( ${mem%G} * 921 ))M" ;;
  *M) high="$(( ${mem%M} * 9 / 10 ))M" ;;
  *K) high="$(( ${mem%K} * 9 / 10 ))K" ;;
esac

if [ "${TAU_NO_CAP:-0}" = "1" ]; then
  exec "$@"
fi

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if ! command -v systemd-run >/dev/null 2>&1 || [ ! -S "$runtime/systemd/private" ]; then
  echo "scripts/cap: REFUSING to run uncapped — systemd-run --user is unavailable." >&2
  echo "  This box has been taken down four times by uncapped or under-capped test runs." >&2
  echo "  Set TAU_NO_CAP=1 to override deliberately." >&2
  exit 70
fi

# TAU_CAP_SLICE and TAU_CAP_TMP move the slice and the runs' temp directories
# somewhere else, which is how a test of this script stays out of the real ones.
# The slice's locks are named for it, so they move with it.
slice="${TAU_CAP_SLICE:-tau-cap.slice}"
tmp="${TAU_CAP_TMP:-/tmp/cap}"

# ★ A GATE HAS THE SLICE TO ITSELF. Every capped run shares the slice's CPU
# quota, and a suite with deadlines in it that shares the host fails tests that
# describe nothing but the contention. A gate is a `make` suite, or any run with
# TAU_CAP_CLASS=gate; every other run is small, as is a `make` run with
# TAU_CAP_CLASS=small. Small runs share the slice with each other, never with a
# gate, and a gate waits for the slice instead of sharing it.
#
# A small run takes the slice's lock shared and a gate takes it exclusively, for
# the whole run: it rides into the scope on fd 8, and the kernel releases it once
# the last process holding it is gone, a killed run's too. A gate then also waits
# until nothing at all is left in the slice, since a process can hold no lock --
# one an older cap started, or one that closed its descriptors -- and still be
# using the host.
#
# ★ A WAITING GATE IS NOT STARVED. A shared lock is granted while others hold it
# however long a gate has waited, so small runs arriving one after another would
# keep a gate out for ever. So every run first passes the slice's door, fd 7. A
# small run holds it only while it takes its shared lock; a gate takes it before
# it waits and keeps it until it ends, so nothing gets in ahead of a waiting
# gate, and whatever waits at the door is told which gate it waits for.
#
# A cap call from inside a run in the same slice is part of that run and takes
# neither, since it would be waiting for the run it is in.
class="${TAU_CAP_CLASS:-}"
if [ -z "$class" ]; then
  case "${1##*/}" in
    make|gmake) class=gate ;;
    *) class=small ;;
  esac
fi
case "$class" in
  gate|small) ;;
  *)
    echo "scripts/cap: TAU_CAP_CLASS is gate or small, not \"$class\"." >&2
    exit 64
    ;;
esac

# runs lists each live scope in the slice, with the command it was started with.
runs() {
  systemctl --user show -p Id -p Slice -p ActiveState -p Description 'tau-cap-*.scope' 2>/dev/null |
    awk -v RS= -F '\n' -v slice="$slice" '{
      id = ""; ours = 0; live = 1; what = ""
      for (i = 1; i <= NF; i++) {
        key = $i; sub(/=.*/, "", key); value = substr($i, length(key) + 2)
        if (key == "Id") id = value
        if (key == "Slice") ours = value == slice
        if (key == "ActiveState") live = value != "inactive" && value != "failed"
        if (key == "Description") what = value
      }
      if (id != "" && ours && live) print "  " id ": " what
    }'
}

populated() {
  local cg
  cg="$(systemctl --user show -p ControlGroup --value "$slice" 2>/dev/null)"
  [ -n "$cg" ] && grep -qx 'populated 1' "/sys/fs/cgroup$cg/cgroup.events" 2>/dev/null
}

still() {
  echo "scripts/cap: still waiting for $slice, $(( (SECONDS - began) / 60 ))m on." >&2
}

# take FLAG FD WHY: takes the lock open on FD. When it has to wait it says why
# and what is in the slice, and every five minutes that it still waits.
take() {
  flock -n "$1" "$2" && return
  waited=1
  echo "scripts/cap: $3" >&2
  runs >&2
  until flock -w 300 "$1" "$2"; do
    still
  done
}

began=$SECONDS
waited=""
case "$(grep '^0::' /proc/self/cgroup 2>/dev/null)" in
  */"$slice"/tau-cap-*.scope) ;;
  *)
    door="$runtime/$slice.door"
    exec 7>>"$door" 8>>"$runtime/$slice.lock"
    holder="$(cat "$door" 2>/dev/null)"
    take -x 7 "waiting for $slice${holder:+, held by a gate: $holder}"
    if [ "$class" = gate ]; then
      printf '%s (pid %s, since %s)\n' "$*" "$$" "$(date '+%F %T')" >"$door"
      take -x 8 "this gate waits for the runs in $slice to end:"
      if populated; then
        waited=1
        echo "scripts/cap: this gate waits for what is still in $slice, holding no lock:" >&2
        runs >&2
        polls=0
        while populated; do
          sleep 2
          polls=$(( polls + 1 ))
          [ $(( polls % 150 )) -ne 0 ] || still
        done
      fi
    else
      : >"$door"
      take -s 8 "waiting for $slice:"
      exec 7>&-
    fi
    if [ -n "$waited" ]; then
      w=$(( SECONDS - began ))
      printf 'scripts/cap: waited %dm%02ds for %s.\n' $(( w / 60 )) $(( w % 60 )) "$slice" >&2
    fi
    ;;
esac

# ★ ONE LOCK, HELD UNTIL THE NEW RUN IS INSIDE ITS SCOPE. Everything below looks
# at the other runs and acts on what it sees — which scopes are alive, whether
# the slice holds anything — and a run that has its directory and its limits but
# has not reached its scope yet is invisible to both. So the lock is not released
# here: it rides through systemd-run on fd 9, and the first thing the command does
# inside the scope is close it.
exec 9>>"$runtime/tau-cap.lock"
if ! flock -w 120 9; then
  echo "scripts/cap: another cap call has held $runtime/tau-cap.lock for 120s." >&2
  exit 75
fi

# Every loaded tau-cap-N.scope, and the ones that still have a run in them.
# Unknown means nothing is swept: a directory is only removed on evidence that
# its run has ended.
declare -A loaded=() live=()
known=""
if units="$(systemctl --user show -p Id -p ActiveState 'tau-cap-*.scope')"; then
  known=1
  while read -r unit state; do
    id="${unit#tau-cap-}"
    id="${id%.scope}"
    loaded[$id]=1
    case "$state" in
      inactive|failed) ;;
      *) live[$id]=1 ;;
    esac
  done < <(awk -v RS= '{
    id = ""; state = ""
    for (i = 1; i <= NF; i++) {
      split($i, kv, "=")
      if (kv[1] == "Id") id = kv[2]
      if (kv[1] == "ActiveState") state = kv[2]
    }
    if (id != "") print id, state
  }' <<<"$units")
fi

# ★ EVERY RUN GETS A TMPDIR OF ITS OWN: $tmp/N, for the scope tau-cap-N. Go's
# work directories and t.TempDir follow TMPDIR, and so does whatever a test makes
# with os.MkdirTemp — none of which a killed run cleans up. MEASURED on the build
# servers, where /tmp is a tmpfs: 2,327 peer repositories and 437 clouds,
# 7.9 GiB on one box, from runs long gone. A tmpfs page stays charged to the
# cgroup that wrote it, so all of it counted against this slice.
#
# So every call first removes the directories of scopes that are no longer
# alive, and a killed run's files go with the next run. Nothing is removed
# outside $tmp, nor anything in it that is not named for a scope. Root's files,
# left by a run under scripts/as-root, take root to remove.
#
# ★ THE PATH IS SHORT ON PURPOSE. A unix socket's path holds 107 bytes, and
# t.TempDir alone adds up to 79 below TMPDIR before a test names its socket —
# containerd.sock is 16 more. /tmp/cap/N leaves room for both; a second user on
# the box, who cannot have /tmp/cap, gets /tmp/cap-UID.
ours() { [ -d "$1" ] && [ ! -L "$1" ] && [ -O "$1" ]; }
mkdir -p -m 700 "$tmp" 2>/dev/null
if ! ours "$tmp" && [ -z "${TAU_CAP_TMP:-}" ]; then
  tmp="/tmp/cap-$(id -u)"
  mkdir -m 700 "$tmp" 2>/dev/null
fi
if ! ours "$tmp"; then
  echo "scripts/cap: $tmp is not a directory this user owns." >&2
  exit 70
fi
if [ -n "$known" ]; then
  for dir in "$tmp"/*; do
    id="${dir##*/}"
    case "$id" in
      ''|*[!0-9]*) continue ;;
    esac
    if [ -d "$dir" ] && [ ! -L "$dir" ] && [ -z "${live[$id]:-}" ]; then
      rm -rf --one-file-system -- "$dir" 2>/dev/null ||
        sudo -n rm -rf --one-file-system -- "$dir" 2>/dev/null ||
        echo "scripts/cap: could not remove $dir, left by a run that has ended." >&2
    fi
  done
fi

# bytes 8G → 8589934592; infinity, or memory.max's max, stays infinity.
bytes() {
  local n="${1%[KMGT]}"
  case "$1" in
    infinity|max) echo infinity; return ;;
  esac
  case "$n" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$1" in
    *K) echo $(( n << 10 )) ;;
    *M) echo $(( n << 20 )) ;;
    *G) echo $(( n << 30 )) ;;
    *T) echo $(( n << 40 )) ;;
    *) echo "$n" ;;
  esac
}

# percent 400% → 400, and cpu.max's "400000 100000" → 400.
percent() {
  local n
  case "$1" in
    *%) n="${1%\%}" ;;
    "max "*) echo infinity; return ;;
    *" "*) n=$(( ${1% *} * 100 / ${1#* } )) ;;
  esac
  case "$n" in
    ''|*[!0-9]*) return 1 ;;
  esac
  echo "$n"
}

# higher UNIT A B: the larger of two limits; nothing when either is unreadable.
higher() {
  local a b
  a="$("$1" "$2")" && b="$("$1" "$3")" || return 0
  if [ "$a" = infinity ] || [ "$b" = infinity ]; then
    echo infinity
  elif [ "$a" -ge "$b" ]; then
    echo "$a"
  else
    echo "$b"
  fi
}

# fit LIMIT ROOM: LIMIT, or ROOM in bytes when LIMIT asks for more, or for none.
fit() {
  local n
  n="$(bytes "$1")" || { echo "$1"; return; }
  if [ "$n" = infinity ] || [ "$n" -gt "$2" ]; then
    echo "$2"
  else
    echo "$1"
  fi
}

# A shared slice bounds every capped run ADDED UP, which the per-scope ceiling
# cannot: five runs each honestly under their own limit still summed past the
# host. CPUQuota is here for the same reason — a sweep reaching load 32 makes the
# desktop unusable without any memory limit being crossed. Failure to set these
# is not fatal; the per-scope caps below are the ones that must hold.
#
# ★ A CALL ONLY LOWERS THE SLICE WHEN NOTHING IS IN IT. These limits used to be
# set to whatever each call asked, so a call taking the 8G default dropped the
# slice under a gate running at 96G, and the kernel OOM-killed the gate's make.
# While a run is inside, each limit only rises, to the larger of what is set and
# what is asked; the slice takes exactly what is asked once it is idle.
#
# ★ NO CALL ASKS FOR MORE THAN ITS HOST HAS. A total sized for a 123G build
# host reached a 31G desktop through an exported TAU_CAP_TOTAL=96G; the slice
# then bounded nothing, and two capped runs beside the desktop took the machine
# to 29G used. What a call asks for is cut to a share of the host's RAM: 85%, or
# half where a desktop session runs, which keeps the other half for the desktop.
total="${TAU_CAP_TOTAL:-8G}"
total_high="${TAU_CAP_TOTAL_HIGH:-6G}"
cpu="${TAU_CAP_CPU:-400%}"
ram="$(awk '/^MemTotal:/ { printf "%d", $2 * 1024 }' "${TAU_CAP_MEMINFO:-/proc/meminfo}")"
if [ -n "$ram" ]; then
  share=85
  systemctl --user is-active -q graphical-session.target 2>/dev/null && share=50
  room=$(( ram / 100 * share >> 20 << 20 ))
  total="$(fit "$total" "$room")"
  total_high="$(fit "$total_high" $(( room / 10 * 9 >> 20 << 20 )))"
fi
cg="$(systemctl --user show -p ControlGroup --value "$slice" 2>/dev/null)"
if [ -n "$cg" ] && grep -qx 'populated 1' "/sys/fs/cgroup$cg/cgroup.events" 2>/dev/null; then
  cg="/sys/fs/cgroup$cg"
  total="$(higher bytes "$total" "$(cat "$cg/memory.max" 2>/dev/null)")"
  total_high="$(higher bytes "$total_high" "$(cat "$cg/memory.high" 2>/dev/null)")"
  cpu="$(higher percent "$cpu" "$(cat "$cg/cpu.max" 2>/dev/null)")"
  case "$cpu" in
    infinity) cpu="" ;;
    ?*) cpu="$cpu%" ;;
  esac
fi
props=(MemorySwapMax=0 IOWeight=10)
[ -n "$total" ] && props+=(MemoryMax="$total")
[ -n "$total_high" ] && props+=(MemoryHigh="$total_high")
[ -n "$cpu" ] && props+=(CPUQuota="$cpu")
systemctl --user set-property "$slice" "${props[@]}" >/dev/null 2>&1 || true

id=1
while [ -n "${loaded[$id]:-}" ] || [ -e "$tmp/$id" ] || [ -L "$tmp/$id" ]; do
  id=$(( id + 1 ))
done
mkdir -m 700 "$tmp/$id" || exit 70
export TMPDIR="$tmp/$id"

# --expand-environment=no hands the command its arguments as they were given.
# systemd-run otherwise substitutes ${VAR} in them first, from its own
# environment, so `sh -c 'echo "${x:-none}"'` ran as `echo ""`.
#
# The description is the command on one line: systemd shows one holding a
# newline as [unprintable], and it is how a waiting run says what it waits for.
exec systemd-run --user --scope -q --collect --slice="$slice" \
  --unit="tau-cap-$id" --description="${*//$'\n'/ }" --expand-environment=no \
  -p MemoryMax="$mem" -p MemoryHigh="$high" -p MemorySwapMax=0 \
  -p TasksMax=4096 -- sh -c 'exec 9>&-; exec "$@"' cap "$@"
