#!/usr/bin/env bash
# Run a test command on a build server instead of on this machine.
#
#   TAU_REMOTE=user@build1 scripts/rtest go test ./services/database/ -race -count=1
#   TAU_REMOTE=user@build1 scripts/rtest go test ./instance/dream/ -tags dreaming -count=1
#   TAU_REMOTE=user@build2 TAU_CAP_MEM=20G scripts/rtest make test-dreaming
#
# TAU_REMOTE names the host and has no default; TAU_REMOTE_KEY names an ssh key
# when the agent's or ~/.ssh/config's would not do.
#
# ★ WHY THIS EXISTS. The suites here are heavy enough to make the machine
# somebody is working on unusable, and the dreaming ones are timing-sensitive:
# a suite that loses the CPU to a compile fails tests that describe nothing but
# the contention. The build servers are idle and have the cores.
#
# ★ IT SHIPS THE WORKING TREE, NOT HEAD, because the whole point is to test
# what is not committed yet. But it ships only what the REPO contains -- every
# tracked file plus anything new that is not ignored -- and never the build
# caches, which are gigabytes of node_modules, target/ and wasm output that the
# remote rebuilds anyway. Shipping the raw tree once took longer than the tests.
#
# ★ IT RUNS UNDER cap ON THE FAR SIDE, for the reason scripts/cap exists: an
# unbounded test run kills the host it is on, and the host being remote does not
# make that acceptable. A `make` command there is a gate: it waits until no
# other capped run is on the host, has the host to itself, and says what it
# waits for. TAU_CAP_CLASS=gate or small classes a command the other way.
set -euo pipefail

host="${TAU_REMOTE:?set TAU_REMOTE to the host that runs the tests, e.g. TAU_REMOTE=user@build1}"
key="${TAU_REMOTE_KEY:-}"
mem="${TAU_CAP_MEM:-12G}"
dir="${TAU_REMOTE_DIR:-tau-rtest}"

if [ $# -eq 0 ]; then
	echo "usage: scripts/rtest <command...>   e.g. scripts/rtest go test ./pkg/... " >&2
	exit 2
fi

ssh_opts=(-o BatchMode=yes -o ConnectTimeout=10)
if [ -n "$key" ]; then
	ssh_opts+=(-o IdentitiesOnly=yes -i "$key")
fi

# WHAT GIT IGNORES IS WHAT IS EXCLUDED, and everything else is synced with
# --delete. Stated as an exclude list rather than a file list, because those two
# spellings differ on the one case that matters: a file the REMOTE has and the
# local tree does not.
#
# ★ --files-from CANNOT DELETE A FILE IT WAS NEVER TOLD ABOUT. That was the
# previous shape here, and this comment used to claim --delete-missing-args
# covered it. It does not: that flag turns a LISTED-but-absent path into a
# deletion, and a stale file is absent from the list entirely, so nothing ever
# looked at it. With --files-from rsync also treats each entry as its own
# transfer root, so --delete has no directory to prune and is a no-op.
#
# MEASURED, not argued: a worktree at a commit predating node/cron.go synced
# into a directory that still had it, and the build died on redeclarations that
# exist in neither tree. Every green run in a reused directory was one stale
# file away from describing a tree that never existed.
#
# ★ AN EXCLUDED PATH IS PROTECTED FROM --delete, which is the whole reason this
# works: `git ls-files --others --ignored --directory` is every path git ignores,
# with directories collapsed, so a 3 GB target/ or node_modules/ on the far side
# is neither sent nor removed. Only what git would track can be pruned.
#
# .git/ stays excluded, and therefore stays protected, exactly as before.
# ★ EVERY PATTERN IS ANCHORED WITH A LEADING SLASH, and leaving it off is a
# quiet way to delete a tracked directory. git prints repo-root-relative PATHS;
# rsync reads a pattern with no slash as "match this name at ANY depth". So an
# ignored `services/monkey/` at the root also matched the TRACKED
# `core/services/monkey/`, which was then never sent and never built. Anchoring
# says what git meant: this path, from the top.
#
# Process substitution rather than a temp file: this script ends in `exec`, so
# an EXIT trap would never fire and every run would leak one.
#
# ★ .deps/warpjs IS IGNORED AND STILL SHIPPED. go.mod replaces warpjs with that
# export (scripts/warpjs-sync), so a tree without it does not build, and a clean
# worktree never has it. Export the pinned commit first, then include it ahead of
# the ignore list, since the first rule that matches wins.
if [ -f scripts/warpjs.commit ]; then
	scripts/warpjs-sync
fi
rsync -a --delete --exclude='.git/' \
	--include='/.deps/' --include='/.deps/warpjs/***' \
	--exclude-from=<(git ls-files --others --ignored --exclude-standard --directory | sed 's|^|/|') \
	-e "ssh ${ssh_opts[*]}" ./ "$host:$dir/"

# Quote every argument so a -run regex or a path with a space survives the shell
# on the far side.
remote=""
for arg in "$@"; do
	remote+=" $(printf '%q' "$arg")"
done

# ★ $HOME/go/bin IS ON THE PATH because `go install`ed tools live there and a
# non-login shell does not look. The proto drift test shells out to
# protoc-gen-go and protoc-gen-connect-go at the versions pkg/proto/buf.gen.yaml
# pins, and it FAILS rather than skips when they are absent -- correctly, since a
# drift check that skipped would report green having checked nothing. Without
# this the tools can be installed on the box and still be invisible here, which
# reads as a code failure and is a PATH.
exec ssh "${ssh_opts[@]}" "$host" \
	"cd $dir && PATH=/usr/local/go/bin:\$HOME/go/bin:\$PATH TAU_CAP_MEM=$mem \
		TAU_CAP_TOTAL=${TAU_CAP_TOTAL:-8G} TAU_CAP_TOTAL_HIGH=${TAU_CAP_TOTAL_HIGH:-6G} \
		TAU_CAP_CPU=${TAU_CAP_CPU:-400%} TAU_NO_CAP=${TAU_NO_CAP:-0} \
		TAU_CAP_CLASS=$(printf '%q' "${TAU_CAP_CLASS:-}") ./scripts/cap$remote"
