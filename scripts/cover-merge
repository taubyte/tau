#!/bin/sh
# cover-merge prints statement coverage per package over the union of the
# given profiles: a block counts as covered when any profile covered it.
# A profile that does not exist, or holds no blocks, contributes nothing.
#
#   scripts/cover-merge unit.out docker.out root.out
set -eu

for f in "$@"; do
	[ -s "$f" ] && cat "$f"
done | awk '
	/^mode:/ { next }
	{ n[$1] = $2; if (!($1 in c) || $3 > c[$1]) c[$1] = $3 }
	END {
		for (b in n) {
			p = b; sub(/:.*/, "", p); sub(/\/[^\/]*$/, "", p)
			total[p] += n[b]; if (c[b] > 0) hit[p] += n[b]
		}
		for (p in total) printf "%-60s %5.1f%%\n", p, 100 * hit[p] / total[p]
	}' | sort
