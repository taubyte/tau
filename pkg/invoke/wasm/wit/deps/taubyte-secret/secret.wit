// A secret's value, as the vocabulary's `secret` kind.
//
// # Why a workload would call this rather than read an environment variable
//
// A secret already reaches a workload as a variable — `variables: {TOKEN:
// {secret: {name: stripe}}}` — and that is the right shape for most of them:
// resolved once, at start, and handed over.
//
// THE DIFFERENCE IS ROTATION. A variable is fixed for the life of the instance,
// so rotating a secret takes effect when the workload restarts. Reading it here
// takes effect on the next call, which is the whole reason the value lives
// outside git in the first place: "rotation needs no push" is not much of a
// promise if it needs a redeploy.
//
// # There is no `set`, and there will not be one
//
// The vocabulary declares one verb and it is a read — "there is no write verb
// from a workload, ever" is its own sentence. A secret is written out of band,
// by whoever holds it, through a door that authorizes on the project.
package taubyte:secret@0.1.0;

interface vault {
    variant error {
        no-such-secret(string),
        denied(string),
        // Declared, and nothing is set under that name. It is its own arm
        // because a workload started without its database password fails
        // somewhere else, later, as an application that looks broken — and an
        // author needs to tell that from an outage.
        not-set,
        unavailable(string),
    }

    get: func(name: string) -> result<list<u8>, error>;
}

world imports {
    import vault;
}
