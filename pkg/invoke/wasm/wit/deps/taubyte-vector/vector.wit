// A vector database, as the vocabulary's `database` kind at `type: vector`.
//
// # What an embedding is on the wire
//
// `list<f32>`, in both directions. It is the one place in this world where a
// number list is the natural shape rather than a convenience: an embedding IS a
// vector of floats, and carrying it as JSON text would mean parsing a thousand
// numbers per call on both sides.
//
// # It is shaped like the client the author already uses
//
// upsert an id with an embedding and some metadata, search by embedding for the
// nearest k. That is Pinecone, Qdrant, Weaviate, pgvector and Chroma at the
// level all five agree on. A metadata FILTER on search is the first thing they
// stop agreeing on — the syntax differs per engine — so it is not here yet
// rather than here in a spelling only one backing could serve.
//
// # The metric is the resource's, not a parameter
//
// It has to match how the embedding model was TRAINED — cosine for normalized
// embeddings, dot where magnitude carries meaning, euclidean for raw distance —
// so it is declared on the database and not chosen per query. Getting it wrong
// does not error; it ranks badly.
//
// Every score is "higher is closer", euclidean's being a negated distance.
package taubyte:vector@0.1.0;

interface store {
    record match {
        id: string,
        score: f32,
        // Whatever was stored beside the embedding, as JSON. Empty when there
        // was none.
        meta: string,
    }

    variant error {
        no-such-database(string),
        denied(string),
        // The embedding is not this database's declared width. It is its own
        // arm because it is a mistake in the CALLER rather than an outage:
        // a 1536-wide query against 768-wide vectors is meaningless, not slow.
        wrong-width(string),
        malformed(string),
        unavailable(string),
    }

    // k <= 0 is everything.
    search: func(name: string, query: list<f32>, k: s32) -> result<list<match>, error>;
    // meta is JSON, or empty for none.
    upsert: func(name: string, id: string, embedding: list<f32>, meta: string) -> result<_, error>;
    delete: func(name: string, id: string) -> result<_, error>;
}

world imports {
    import store;
}
